---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import LikeButton from '../../components/LikeButton.tsx';
import TableOfContents from '../../components/TableOfContents.astro';
import LanguageToggle from '../../components/LanguageToggle';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={`${post.data.title} | Ken Xiao`}>
  <!-- Table of Contents -->
  <TableOfContents headings={headings} />

  <article class="max-w-3xl mx-auto">
    <header class="mb-10 text-center">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="text-sm text-accent font-mono uppercase tracking-wider">
          {post.data.category}
        </div>
        <LanguageToggle client:load />
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4 leading-tight">
        <span class="title-cn">{post.data.title}</span>
        {post.data.titleEn && (
          <span class="title-en text-2xl md:text-3xl text-gray-500 dark:text-gray-400 block mt-2 font-normal">{post.data.titleEn}</span>
        )}
      </h1>
      {(post.data.description || post.data.descriptionEn) && (
        <div class="description-wrapper mb-4">
          {post.data.descriptionEn && (
            <p class="description-en text-gray-500 dark:text-gray-400 text-base italic max-w-2xl mx-auto">{post.data.descriptionEn}</p>
          )}
        </div>
      )}
      <div class="text-gray-500 text-sm font-mono">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </div>
    </header>

    <div class="prose dark:prose-invert max-w-none prose-headings:font-serif prose-a:text-accent hover:prose-a:text-accent/80">
      <Content />
    </div>

    <div class="mt-8 flex justify-center">
      <LikeButton client:load contentType="blog" contentId={post.slug} />
    </div>

    <hr class="my-12 border-gray-200 dark:border-gray-800" />

    <div class="mt-12">
      <h3 class="text-xl font-serif font-bold mb-6">Comments</h3>
      <Comments />
    </div>
  </article>

  <style>
    /* Hide English content when bilingual mode is off */
    :global(html[data-bilingual="false"]) .title-en,
    :global(html[data-bilingual="false"]) .description-en {
      display: none !important;
    }
  </style>

  <script>
    // Initialize bilingual mode on page load
    const savedBilingual = localStorage.getItem('showBilingual');
    if (savedBilingual !== null) {
      document.documentElement.setAttribute('data-bilingual', savedBilingual);
    } else {
      document.documentElement.setAttribute('data-bilingual', 'true');
    }
  </script>
</BaseLayout>
